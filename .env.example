# --- required ---------------------------------------------------------------------------------------------
# random secret for admin sessions:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# argon2 hash of the admin password:  docker compose run --rm app python -m app.cli hash-password
# keep the single quotes – the hash contains '$' characters
ADMIN_PASSWORD_HASH=''
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=

# --- site operator (Impressum per § 5 ECG / § 25 MedienG, privacy policy) -------------------------------------
# public URL; also sent in the importer's user agent so restaurant websites can identify (and allow) it
SITE_BASE_URL=https://lunch.example.org
SITE_HOSTING="Oracle Cloud Infrastructure, Region eu-frankfurt-1"
IMPRESSUM_OWNER="Vorname Nachname"
IMPRESSUM_ADDRESS="Straße Hausnummer, PLZ Ort, Österreich"
IMPRESSUM_EMAIL=kontakt@example.org
IMPRESSUM_PHONE=
IMPRESSUM_PURPOSE="Private, nicht-kommerzielle Website: Übersicht über Mittagsmenüs regionaler Restaurants"
# Aufsichtsbehörde, Kammer, UID … if applicable
IMPRESSUM_AUTHORITY=
IMPRESSUM_MEDIA_LINE="Information über Mittagsmenüs regionaler Restaurants"
# SITE_NAME=Lunchtime

# --- optional ---------------------------------------------------------------------------------------------
# uid/gid of the user owning this checkout on the host (id -u / id -g)
APP_UID=1000
APP_GID=1000
TZ=Europe/Vienna
# cron expressions separated by ";" (default: hourly 6–12 on weekdays and Sunday 18:00)
IMPORT_SCHEDULE=0 6-12 * * mon-fri; 0 18 * * sun

# --- optional LLM fallback (leave LLM_PROVIDER empty to disable) -------------------------------------------
# Anthropic Claude: the PDF is sent directly to the model
LLM_PROVIDER=
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Ollama, OpenRouter, LM Studio, …): positioned PDF text is sent
# LLM_PROVIDER=openai
# LLM_MODEL=
# OPENAI_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1
